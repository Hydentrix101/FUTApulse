# Local FUTApulse server configuration. Copy this file to .env and replace the
# Google values with the credentials from your Google Cloud OAuth web client.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# Event report review email destination and event-link origin.
FUTAPULSE_ADMIN_EMAIL=immanuelidowu1@gmail.com
FRONTEND_URL=http://localhost:5173

# SMTP is also used to email event-report review requests to the admin above.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=immanuelidowu1@gmail.com
# SMTP_PASS=your-gmail-app-password
# SMTP_SECURE=false
# MAIL_FROM=FUTApulse <immanuelidowu1@gmail.com>

# Use a separate development/staging database before production. Never commit
# a real connection string. Development can omit this and use local JSON.
# Production requires MongoDB and remains blocked until the Phase 2 storage cutover is complete.
# MONGO_URI=mongodb://127.0.0.1:27017/futapulse
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>
# JWT_SECRET=replace-with-a-long-random-secret
