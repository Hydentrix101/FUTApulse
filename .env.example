# Local FUTApulse server configuration. Copy this file to .env and replace the
# Google values with credentials from your Google Cloud OAuth web client.
GOOGLE_CLIENT_ID=your-google-oauth-web-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5173

# Outbound email uses the Gmail API over HTTPS, not SMTP. Enable Gmail API in
# Google Cloud and authorize a refresh token with the gmail.send scope.
# The sender address must belong to the Google account that granted that token.
GMAIL_REFRESH_TOKEN=your-gmail-api-refresh-token
GMAIL_SENDER_EMAIL=sender@gmail.com

# Event report review email destination and event-link origin.
FUTAPULSE_ADMIN_EMAIL=immanuelidowu1@gmail.com
FRONTEND_URL=http://localhost:5173

# Use a separate development/staging Atlas database before production.
# Never commit a real connection string. When MONGO_URI is omitted, development
# uses local JSON. If MongoDB connects once, the server will not fall back to
# stale JSON if Atlas later becomes unavailable.
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# JWT_SECRET=replace-with-a-long-random-secret

# Leave false/unset until the local migration has been applied and the MongoDB
# API has passed smoke tests. Production startup is blocked otherwise.
# FUTAPULSE_MONGO_CUTOVER_COMPLETE=false
