# FUTApulse PWA configuration.
# Local development only: run the Express API on port 3001. For Vercel production,
# leave VITE_API_BASE_URL unset; client/vercel.json proxies /api to Render so auth
# stays on the app origin for SameSite=Lax cookies. For a non-proxied host, set
# this to its API origin (for example, https://futapulse.onrender.com) only after
# configuring cookie/CORS behavior for that deployment.
VITE_API_BASE_URL=http://localhost:3001
# Optional direct Socket.IO origin. Defaults to the API URL locally and Render in production.
# VITE_SOCKET_URL=https://futapulse.onrender.com
# Live ads require an explicit opt-in and a configured provider.
VITE_IS_ADS_LIVE=false
VITE_ADS_MODE=mock
VITE_LAUNCH_AD_VIDEO_URL=
