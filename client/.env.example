# FUTApulse mobile app ad preparation.
# Keep mock mode until a native Android/iOS ads adapter is installed and reviewed.
# Local development default. For production on Vercel, leave VITE_API_BASE_URL
# empty and add a same-origin /api rewrite in client/vercel.json to the Render API.
# Do not point browser requests directly at *.onrender.com: auth uses a SameSite=Lax
# refresh cookie and needs requests to stay on the Vercel app origin.
VITE_API_BASE_URL=http://localhost:3001
VITE_ADS_MODE=mock

# AdMob identifiers are public platform IDs, not secrets.
# Add real IDs only after the matching native mobile SDK is configured.
# Native app IDs may also need to be added to Android manifest/iOS plist files.
VITE_ADMOB_ANDROID_APP_ID=
VITE_ADMOB_ANDROID_NATIVE_AD_UNIT_ID=
VITE_ADMOB_ANDROID_APP_OPEN_AD_UNIT_ID=

VITE_ADMOB_IOS_APP_ID=
VITE_ADMOB_IOS_NATIVE_AD_UNIT_ID=
VITE_ADMOB_IOS_APP_OPEN_AD_UNIT_ID=
