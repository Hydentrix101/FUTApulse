{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "fut-apulse.vercel.app"
        }
      ],
      "destination": "https://www.futapulse.com.ng/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://futapulse.onrender.com/api/:path*"
    },
    {
      "source": "/robots.txt",
      "destination": "https://futapulse.onrender.com/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://futapulse.onrender.com/sitemap.xml"
    },
    {
      "source": "/about",
      "destination": "https://futapulse.onrender.com/seo/pages/about"
    },
    {
      "source": "/privacy",
      "destination": "https://futapulse.onrender.com/seo/pages/privacy"
    },
    {
      "source": "/terms",
      "destination": "https://futapulse.onrender.com/seo/pages/terms"
    },
    {
      "source": "/guidelines",
      "destination": "https://futapulse.onrender.com/seo/pages/guidelines"
    },
    {
      "source": "/contact",
      "destination": "https://futapulse.onrender.com/seo/pages/contact"
    },
    {
      "source": "/events/:eventId/:slug",
      "destination": "https://futapulse.onrender.com/seo/events/:eventId/:slug"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}
